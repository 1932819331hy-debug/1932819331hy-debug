+def split_record_ending(record: str) -> tuple[str, str]:
+    """Separate a CSV record's terminator, leaving embedded newlines intact."""
+    for ending in ("\r\n", "\n", "\r"):
+        if record.endswith(ending):
+            return record[:-len(ending)], ending
+    return record, ""
 
